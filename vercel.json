{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "nodeVersion": "18.x",
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Mwangaza Hardware"
  },
  "envPrefix": "NEXT_PUBLIC_",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/docs(.*)",
      "destination": "https://docs.example.com$1"
    }
  ]
}
